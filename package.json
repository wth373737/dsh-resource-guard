{
  "name": "@local/dsh-resource-guard",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "description": "Predict and gate memory/VRAM-heavy tool calls, tune concurrency to this machine, and expose the thresholds in Settings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wth373737/dsh-resource-guard.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
